# /etc/systemd/system/flyingfish.service
#
# Main FlyingFish stack. Wraps `docker compose up -d` so the unit returns once
# the stack is detached, then `docker compose down` on stop.
#
# Depends on the first-boot service so the `docker load` of the pre-baked
# flyingfish.tar and the `.env` secret generation finish before we bring the
# stack up. `docker compose` reads /opt/flyingfish/.env automatically.

[Unit]
Description=FlyingFish — reverse proxy / router stack
Documentation=https://github.com/stefanwerfling/flyingfish
Requires=docker.service flyingfish-firstboot.service
After=docker.service flyingfish-firstboot.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/flyingfish
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# The stack is large; first `up` may pull nothing (images pre-loaded) but still
# needs time to start mariadb/influx/redis health gates on a Pi.
TimeoutStartSec=600
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
