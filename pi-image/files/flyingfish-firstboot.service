# /etc/systemd/system/flyingfish-firstboot.service
#
# Runs `firstboot.sh` exactly once: `docker load`s the bundled
# /opt/flyingfish/flyingfish.tar and generates /opt/flyingfish/.env with fresh
# random secrets, then stamps itself done so subsequent boots skip straight to
# flyingfish.service.

[Unit]
Description=FlyingFish first-boot setup (load images + generate secrets)
Documentation=https://github.com/stefanwerfling/flyingfish
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/flyingfish/flyingfish.tar

[Service]
Type=oneshot
ExecStart=/opt/flyingfish/firstboot.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
# No start timeout: the one-shot `docker load`s a multi-GB image tarball onto a
# slow Pi SD card, which can take well over the old 900s and must not be killed
# mid-unpack (leaves the image store half-populated).
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
