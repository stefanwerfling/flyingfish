exports[`NginxService config generation (characterization, integration) generates a baseline config from an empty database 1`] = `
"
user root;
worker_processes auto;
pid /tmp/ff-char-nginx/nginx.pid;
error_log /tmp/ff-char-nginx/logs/error.log;

events {
	worker_connections 4096;
}
daemon off;
pcre_jit on;

stream {
	js_import mainstream from /tmp/ff-char-nginx/dist/mainstream.js;
	resolver 8.8.8.8 valid=1s;

	upstream ffus_internsshserver {
		server 10.103.0.4:22;
	}

	upstream ffus_internsshserver_proxy {
		server 127.0.0.1:20000;
	}


	server {
		listen 127.0.0.1:20000 proxy_protocol;
		proxy_pass 10.103.0.4:22;
	}

}

http {
	js_import mainhttp from /tmp/ff-char-nginx/dist/mainhttp.js;
	default_type application/octet-stream;
	sendfile on;
	server_tokens off;
	tcp_nopush on;
	tcp_nodelay on;
	client_body_temp_path /tmp/ff-char-nginx/body 1 2;
	keepalive_timeout 90s;
	proxy_connect_timeout 90s;
	proxy_send_timeout 90s;
	proxy_read_timeout 90s;
	ssl_prefer_server_ciphers on;
	gzip on;
}
"
