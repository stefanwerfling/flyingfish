# ==========================================================================
# FlyingFish .gitignore
# Consolidated 2026-08-23: the previous file listed 3364 individual
# plugins/node_modules/* paths. Replaced with globs.
# ==========================================================================

# --- Dependencies ---------------------------------------------------------
**/node_modules/

# --- Build artifacts ------------------------------------------------------
**/dist/
**/*.tsbuildinfo

# --- Lockfiles (this project intentionally does not commit package-lock.json)
**/package-lock.json

# --- Secrets / local configuration ----------------------------------------
/.env
/config.json

# --- Local image exports (multiple GB) ------------------------------------
*.tar

# --- IDE ------------------------------------------------------------------
/.idea
/.vscode

# --- Docs (working notes) -------------------------------------------------
/doc/work

# --- nginx runtime data (generated / at runtime) --------------------------
/nginx/logs
/nginx/servers
/nginx/sample
/nginx/body
/nginx/nginx.conf
/nginx/nginx.pid
/nginx/dhparam.pem

# --- Local / generated areas ----------------------------------------------
/nginxtest
/letsencrypt
/sshserver/ssh
/frontend/assets

# --- Logs -----------------------------------------------------------------
**/*.log
