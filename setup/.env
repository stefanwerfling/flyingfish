# ============================================================================
# FlyingFish environment template
# Copy into ./ (-> ./.env) and replace every value marked CHANGE_ME with a
# strong, random secret. The real .env is excluded via .gitignore and must
# NEVER be committed.
# ============================================================================

# DB
## MARIADB
MARIADB_ROOT_USERNAME=root
MARIADB_ROOT_PASSWORD=CHANGE_ME_strong_db_password
MARIADB_DATABASE=flyingfish

## INFLUXDB
INFLUXDB_URL=http://10.103.0.5:8086
INFLUXDB_USERNAME=flyingfish
INFLUXDB_PASSWORD=CHANGE_ME_strong_influx_password
INFLUXDB_ORG=flyingfish
INFLUXDB_BUCKET=flyingfish
INFLUXDB_RETENTION=4w
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_long_random_influx_token

## REDIS
REDIS_URL='redis://10.103.0.7:6379'
REDIS_SAVE='20 1'
REDIS_LOGLEVEL=warning
REDIS_REQUIREPASS=CHANGE_ME_long_random_redis_password
REDIS_MAX_MEMORY='50mb'

# HTTP Server
HTTPSERVER_PORT=3000

# Hub registry (v2 modular architecture): shared secret parts use to self-register
# with the backend, and the backend URL they POST to. REGISTRY_URL is for parts on
# the flyingfishNet bridge (ddns/ssh); REGISTRY_URL_HOST is for the host-networked
# himhip (reaches the backend via the published port). Adjust the scheme if the
# backend http server runs over https.
REGISTRY_SECRET=change-me-shared-registry-secret
REGISTRY_URL='http://10.103.0.3:3000'
REGISTRY_URL_HOST='http://127.0.0.1:3000'

# Logging
LOGGING_LEVEL=silly

# Service
## Admin (optional): initial password of the ffadmin user on first start.
## Leave empty -> a strong random password is generated and logged once.
## Change it in the UI afterwards.
# FLYINGFISH_ADMIN_INIT_PASSWORD=

## Dyn Dns Server
DYNDNSSERVER_ENABLE=1
