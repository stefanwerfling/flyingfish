# nginx add-module config for the FlyingFish native modules (nginx-native epic):
#   - Phase C: stream (L4) + http (L7) access modules, sharing one control-socket core.
#   - Phase F: http (L7) JWT auth module, with a standalone (nginx-free) verification
#     core (ngx_ff_jwt.c) that links OpenSSL crypto (available via --with-http_ssl_module).
# Statically linked (--add-module, NOT --add-dynamic-module) to match the nginxserver
# image, which ships no /usr/lib/nginx/modules payload.
#
# The shared access core (ngx_flyingfish_access_core.c) is compiled once (attached to
# the stream module's sources); the http access module references its symbols. The JWT
# core (ngx_ff_jwt.c) is attached to the JWT module. Everything links into the one
# nginx binary.
ngx_addon_name=ngx_flyingfish_access

FF_CORE_SRC="$ngx_addon_dir/ngx_flyingfish_access_core.c $ngx_addon_dir/ngx_ff_access_cache.c $ngx_addon_dir/ngx_ff_access_metrics.c $ngx_addon_dir/ngx_ff_access_keepalive.c"
FF_CORE_DEP="$ngx_addon_dir/ngx_flyingfish_access_core.h $ngx_addon_dir/ngx_ff_access_cache.h $ngx_addon_dir/ngx_ff_access_metrics.h $ngx_addon_dir/ngx_ff_access_keepalive.h"
FF_STREAM_SRC="$ngx_addon_dir/ngx_stream_flyingfish_access_module.c"
FF_HTTP_SRC="$ngx_addon_dir/ngx_http_flyingfish_access_module.c"
FF_JWT_SRC="$ngx_addon_dir/ngx_ff_jwt.c"
FF_JWT_DEP="$ngx_addon_dir/ngx_ff_jwt.h"
FF_HTTP_JWT_SRC="$ngx_addon_dir/ngx_http_flyingfish_jwt_module.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=STREAM
    ngx_module_name=ngx_stream_flyingfish_access_module
    ngx_module_srcs="$FF_STREAM_SRC $FF_CORE_SRC"
    ngx_module_deps="$FF_CORE_DEP"
    . auto/module

    ngx_module_type=HTTP
    ngx_module_name=ngx_http_flyingfish_access_module
    ngx_module_srcs="$FF_HTTP_SRC"
    ngx_module_deps="$FF_CORE_DEP"
    . auto/module

    ngx_module_type=HTTP
    ngx_module_name=ngx_http_flyingfish_jwt_module
    ngx_module_srcs="$FF_HTTP_JWT_SRC $FF_JWT_SRC"
    ngx_module_deps="$FF_JWT_DEP"
    . auto/module
else
    STREAM_MODULES="$STREAM_MODULES ngx_stream_flyingfish_access_module"
    HTTP_MODULES="$HTTP_MODULES ngx_http_flyingfish_access_module ngx_http_flyingfish_jwt_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $FF_STREAM_SRC $FF_HTTP_SRC $FF_HTTP_JWT_SRC $FF_CORE_SRC $FF_JWT_SRC"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $FF_CORE_DEP $FF_JWT_DEP"
fi
